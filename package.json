{
  "name": "sistema-prestamos-frontend",
  "private": true,
  "description": "Compilación de Tailwind CSS para el sistema de préstamos (JSP)",
  "scripts": {
    "build:css": "tailwindcss -i src/main/frontend/tailwind.css -o src/main/webapp/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/main/frontend/tailwind.css -o src/main/webapp/assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
